{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "URnetwork Embed Example",
  "version": "0.1.0",
  "identifier": "com.example.urnetwork-embed",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "URnetwork embed",
        "width": 600,
        "height": 700,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
