<?xml version="1.0" encoding="utf-8"?>
<!--
Android 12 and later: neither cloud backups nor device transfers copy the installation state. The
no-backup files directory is already left out; this names it so the rule is explicit.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="no_backup/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup/" />
    </device-transfer>
</data-extraction-rules>
