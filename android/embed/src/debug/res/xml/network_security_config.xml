<?xml version="1.0" encoding="utf-8"?>
<!--
Debug builds only: cleartext HTTP to the loopback token server for local testing, from the
emulator (10.0.2.2 is the host's loopback) or from a device through adb reverse tcp:8790 tcp:8790
(127.0.0.1). Everything else, including the URnetwork API, stays HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
