<?xml version="1.0" encoding="utf-8"?>
<!--
Debug builds only: adb imports the token server settings (its URL and the demo session) or a
scoped client JWT into the installation state, for local testing. Release builds have no import
path; your app's own sign-in provides the session. Only the shell and the system hold the DUMP
permission, so other apps cannot send this broadcast.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".DebugEmbedImportReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
